# Copy to .env, fill in, never commit.
# Generate secrets with: python -c "import secrets; print(secrets.token_hex(32))"
PLI_PEPPER=
PLI_COHORT_ID=iut-mmi-2026
PLI_HOST=pli.example.org

# Dedicated transactional provider, retention disabled.
# Never the shared Postfix infrastructure.
PLI_SMTP_HOST=
PLI_SMTP_PORT=587
PLI_SMTP_USER=
PLI_SMTP_PASSWORD=
PLI_MAIL_FROM=

# Shared secret in the bounce/complaint webhook URL:
# configure the provider to POST to https://$PLI_HOST/webhooks/mail/$PLI_MAIL_WEBHOOK_TOKEN
PLI_MAIL_WEBHOOK_TOKEN=

# Billing: off (everything free), stripe (open reference provider), or a
# private plugin module exposing create_provider(settings) — the closed
# half of the open-core split (see examples/pro_plugin_skeleton.py).
PLI_BILLING=off
PLI_BILLING_PLUGIN=
PLI_STRIPE_SECRET=
PLI_STRIPE_PRICE_ID=
PLI_STRIPE_WEBHOOK_SECRET=

# Legal identity rendered into /legal/* (a French SASU).
PLI_COMPANY_NAME=
PLI_COMPANY_ADDRESS=
PLI_COMPANY_SIREN=
PLI_COMPANY_CONTACT=

# AGPL §13 source offer — point at your fork if you modify the code.
PLI_SOURCE_URL=https://github.com/MayetSoft/SecretCrush

# Transparency page: build attestation + warrant canary.
# Update the canary quarterly; renewal is the signal.
PLI_BUILD_COMMIT=
PLI_IMAGE_DIGEST=
PLI_CANARY_UPDATED=
PLI_TRANSPARENCY_REQUESTS=0
